generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ReservationStatus {
  RESERVED
  PURCHASED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  name         String
  dueDate      DateTime?
  babyGender   String?
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lists        BabyList[]
}

model BabyList {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  occasion    String?    // "birth", "birthday", "baptism", "confirmation", "other"
  childName   String?    // full name, so guests can find the list by the child's name
  description String?
  shareSlug   String     @unique @default(cuid())
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       ListItem[]

  @@index([userId])
}

model ListItem {
  id          String       @id @default(cuid())
  listId      String
  list        BabyList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  priority    Priority     @default(MEDIUM)
  note        String?
  createdAt   DateTime     @default(now())
  reservation Reservation?

  @@index([listId])
  @@index([productId])
}

model Reservation {
  id            String            @id @default(cuid())
  listItemId    String            @unique
  listItem      ListItem          @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  reservedBy    String
  reservedAt    DateTime          @default(now())
  status        ReservationStatus @default(RESERVED)
  purchasedAt   DateTime?
  note          String?
  isGroupBuy    Boolean           @default(false)
  targetAmount  Float?
  // Secret held only by the reserver's browser; lets them cancel or mark purchased.
  ownerToken    String?
  contributors  GroupContributor[]
}

enum ContributorRole {
  ORDERER
  CONTRIBUTOR
}

model GroupContributor {
  id            String          @id @default(cuid())
  reservationId String
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  name          String
  role          ContributorRole @default(CONTRIBUTOR)
  amount        Float
  note          String?
  ownerToken    String?
  createdAt     DateTime        @default(now())

  @@index([reservationId])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  parentId         String?
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryTree")
  products         Product[]
  categoryMappings CategoryMapping[]
}

model CategoryMapping {
  id           String   @id @default(cuid())
  externalName String
  shopSlug     String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([externalName, shopSlug])
}

model Product {
  id               String            @id @default(cuid())
  name             String
  description      String?           @db.Text
  price            Float
  originalPrice    Float?
  currency         String            @default("EUR")
  brand            String?
  sortKey          Float?
  imageUrl         String?
  productUrl       String
  sku              String?
  inStock          Boolean           @default(true)
  shopName         String
  shopSlug         String
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  lastScraped      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  listItems        ListItem[]
  featuredProducts FeaturedProduct[]

  @@index([productUrl])
  @@index([shopSlug])
  @@index([categoryId])
  @@index([brand])
  @@index([sortKey])
}

model FeaturedProduct {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model ScrapedShop {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  baseUrl       String
  isActive      Boolean   @default(true)
  lastRun       DateTime?
  lastStatus    String?
  errorMsg      String?
  productsCount Int       @default(0)
  // Secret a shop uses to report purchases that came from our links (POST /api/conversions).
  conversionKey String?
  createdAt     DateTime  @default(now())

  @@index([conversionKey])
}

// First-party, cookieless analytics: no identifier is stored in the visitor's browser.
// visitorId is a hash of IP + user agent with a salt that changes every day, so it
// can count unique visitors within a day but can't follow anyone across days.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  type        String   // pageview | engagement | outbound | share | search | reserve_start
  path        String?
  visitorId   String
  listId      String?
  productId   String?
  shopSlug    String?
  source      String?  // where an outbound click came from: katalog, lista, moja-lista, blog
  referrer    String?  // referring host only
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  device      String?  // mobile | tablet | desktop
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([shopSlug, createdAt])
  @@index([listId])
}

// A purchase a shop reports back for a click it received from us (click id in lc_click).
// value is what the shop reports: products without VAT and shipping; commission is taken on it.
model Conversion {
  id         String   @id @default(cuid())
  shopSlug   String
  clickId    String?
  orderId    String?
  value      Float?
  currency   String   @default("EUR")
  // reported (counts) | returned (goods sent back, not charged) | rejected (duplicate or fake) | expired (more than 30 days after the click)
  status     String   @default("reported")
  channel    String?  // pixel (tag in the shop's browser) | server (shop's server) | key (old keyed endpoint)
  items      String?  // product ids from the shop's feed, as sent
  clickAt    DateTime?
  createdAt  DateTime @default(now())

  @@unique([shopSlug, orderId])
  @@index([shopSlug, createdAt])
}

// One "U dućan" click as the merchant price list counts it: the click id the shop receives
// (lc_click), the product price at that moment and what the click costs the shop.
model OutboundClick {
  id          String   @id // lc_ + 16 hex characters
  productId   String?
  productName String
  productSku  String?
  shopSlug    String
  listId      String?
  campaign    String   // lista | rodjendan | katalog
  source      String   // where on Listica the click happened
  price       Float    // product price when clicked; it decides the click price
  cpc         Float    // click price in EUR without VAT; 0 when the click is not charged
  billable    Boolean  // false for a repeat click on the same product from the same device the same day
  visitorId   String
  device      String?
  createdAt   DateTime @default(now())

  @@index([shopSlug, createdAt])
  @@index([visitorId, productId])
}

// Money a shop paid in advance for clicks; clicks are deducted from it (prepaid balance).
model ShopTopUp {
  id        String   @id @default(cuid())
  shopSlug  String
  amount    Float
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([shopSlug])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  content        String    @db.Text // Markdown; [[proizvod:<id>]] embeds a catalog product
  coverImage     String?   // URL, our own /api/blog/images/<id> or an external one
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

// Blog images live in the database: Railway has no object storage and the blog is small.
model BlogImage {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}
