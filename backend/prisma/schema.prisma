generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ReservationStatus {
  RESERVED
  PURCHASED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  googleId     String?    @unique
  name         String
  dueDate      DateTime?
  babyGender   String?
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lists        BabyList[]
}

model BabyList {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  occasion    String?    // "birth", "birthday", "baptism", "confirmation", "other"
  childName   String?    // full name, so guests can find the list by the child's name
  description String?
  shareSlug   String     @unique @default(cuid())
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       ListItem[]

  @@index([userId])
}

model ListItem {
  id          String       @id @default(cuid())
  listId      String
  list        BabyList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  priority    Priority     @default(MEDIUM)
  note        String?
  createdAt   DateTime     @default(now())
  reservation Reservation?

  @@index([listId])
  @@index([productId])
}

model Reservation {
  id            String            @id @default(cuid())
  listItemId    String            @unique
  listItem      ListItem          @relation(fields: [listItemId], references: [id], onDelete: Cascade)
  reservedBy    String
  reservedAt    DateTime          @default(now())
  status        ReservationStatus @default(RESERVED)
  note          String?
  isGroupBuy    Boolean           @default(false)
  targetAmount  Float?
  // Secret held only by the reserver's browser; lets them cancel or mark purchased.
  ownerToken    String?
  contributors  GroupContributor[]
}

enum ContributorRole {
  ORDERER
  CONTRIBUTOR
}

model GroupContributor {
  id            String          @id @default(cuid())
  reservationId String
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  name          String
  role          ContributorRole @default(CONTRIBUTOR)
  amount        Float
  note          String?
  ownerToken    String?
  createdAt     DateTime        @default(now())

  @@index([reservationId])
}

model Category {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  parentId         String?
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[]        @relation("CategoryTree")
  products         Product[]
  categoryMappings CategoryMapping[]
}

model CategoryMapping {
  id           String   @id @default(cuid())
  externalName String
  shopSlug     String?
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([externalName, shopSlug])
}

model Product {
  id               String            @id @default(cuid())
  name             String
  description      String?           @db.Text
  price            Float
  originalPrice    Float?
  currency         String            @default("EUR")
  brand            String?
  sortKey          Float?
  imageUrl         String?
  productUrl       String
  sku              String?
  inStock          Boolean           @default(true)
  shopName         String
  shopSlug         String
  categoryId       String?
  category         Category?         @relation(fields: [categoryId], references: [id])
  lastScraped      DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  listItems        ListItem[]
  featuredProducts FeaturedProduct[]

  @@index([productUrl])
  @@index([shopSlug])
  @@index([categoryId])
  @@index([brand])
  @@index([sortKey])
}

model FeaturedProduct {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

model ScrapedShop {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  baseUrl       String
  isActive      Boolean   @default(true)
  lastRun       DateTime?
  lastStatus    String?
  errorMsg      String?
  productsCount Int       @default(0)
  createdAt     DateTime  @default(now())
}
